#!/bin/sh
# Builds the decode benchmark with the app's ImageReader and ImageSize, then
# runs it over the photos in Samples/, or in the folders or files given as
# arguments.
set -eu

cd "$(dirname "$0")/.."
binary="${TMPDIR:-/tmp}/keeps-decode-benchmark"

swiftc -O -swift-version 6 -parse-as-library \
    -o "$binary" \
    Benchmarks/DecodeBenchmark.swift Keeps/Images/ImageReader.swift Keeps/Images/ImageSize.swift

if [ "$#" -eq 0 ]; then
    set -- Samples
fi
"$binary" "$@"
